# .env.example
# 실제 사용 시 .env로 복사 후 값 입력
# cp .env.example .env

# ── 환경 ────────────────────────────────────
ENVIRONMENT=local           # local | production

# ── PostgreSQL ───────────────────────────────
POSTGRES_DB=surbi
POSTGRES_USER=surbi_user
POSTGRES_PASSWORD=your_password_here
DATABASE_URL=postgresql+asyncpg://surbi_user:your_password_here@postgres:5432/surbi

# ── Redis ────────────────────────────────────
REDIS_PASSWORD=your_redis_password_here
REDIS_MAXMEMORY=256mb
REDIS_URL=redis://:your_redis_password_here@redis:6379/0

# ── FastAPI ──────────────────────────────────
SECRET_KEY=your_secret_key_min_32chars_here
DEBUG=false

# ── 외부 API ─────────────────────────────────
LLM_API_KEY=your_llm_api_key_here
KAKAO_API_KEY=your_kakao_api_key_here
